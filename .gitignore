# Relay runtime output. The relay writes relay.log next to wherever it is run from, so a dev run
# started at the repo root leaves one there; the packaged install writes to %LOCALAPPDATA% instead.
# dist/ and build/ above already cover the PyInstaller output under relay/.
relay.log
relay/relay.log

# Dev Planning (not tracked)
Dev Planning/

# xml is intentionally tracked - sample/test xml is a localized simulated-testing
# dependency, and docs/ ships eConnect reference xml. do not re-add a blanket *.xml ignore.

# docs/: vendored UC Connects source has its own .gitignore (bin/obj/.vs/.suo/.user);
# also exclude its ClickOnce publish output (regenerable build artifact)
docs/**/publish/

# Impeccable design skill. iui/ and .impeccable/design.json are the shared contract and are
# tracked; everything below is per-machine state. These were previously only in .git/info/exclude,
# which does not survive a clone.
.impeccable/hook.cache.json
.impeccable/config.local.json
.impeccable/live/
.impeccable/critique/

# Credentials
clerk_credentials.txt
