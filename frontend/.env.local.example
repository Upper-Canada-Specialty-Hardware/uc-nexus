# Normally generated per worktree by localdev/bootstrap-worktree.ps1 from
# %LOCALAPPDATA%\uc-nexus\secrets.env. This .example is the manual fallback / field reference.

# Clerk DEV-instance publishable key (pk_test_...). Publishable keys are not secret.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Leave unset for local dev: the Vite proxy forwards /graphql + /admin to the backend on the
# worktree's backend port (vite.config.ts reads UC_BACKEND_PORT; start-frontend.ps1 sets it).
# VITE_GRAPHQL_URL=/graphql
