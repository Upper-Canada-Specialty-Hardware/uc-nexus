# Manual reference for backend env vars. Copy to backend/.env and fill in real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uc_nexus

# Enables the GET /testing/clerk-sign-in token endpoint used by simulated user testing.
TESTING_ENABLED=true

# SHA-256 hex of the shared testing sign-in secret (#422). /testing/clerk-sign-in additionally
# requires an Admin/Manager session OR this digest's preimage in an X-Testing-Secret header -
# the secret is how a fresh PR environment mints its first session. Generate a pair with:
#   python -c "import secrets,hashlib; s=secrets.token_urlsafe(32); print(s, hashlib.sha256(s.encode()).hexdigest())"
# Blank disables the secret path (admin session only). Set per-environment; it always wins over the
# inherited digest below.
TESTING_SIGN_IN_SECRET_HASH=

# The same digest, under the name a PREVIEW environment inherits. PRODUCTION ONLY, and inert there:
# the resolver refuses to read it in production, which is what makes it safe to store where every new
# preview is cloned from. Without this, each PR environment needed the variable above set by hand
# before anything could be tested on it.
# Same generator one-liner as above. Blank keeps the manual per-environment path.
PREVIEW_TESTING_SIGN_IN_SECRET_HASH=

# Clerk DEV-instance secret key (sk_test_...). Needed for sign-in tokens and admin-gated
# resolvers. Get it from the shared dev Clerk instance. Never commit your real .env.
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk user id of the dedicated e2e testing account (preview-env autonomy plan). Not a real person -
# a user created once in the Clerk dashboard (e.g. e2e-tester@ucsh.com) and granted Admin/Manager via
# its publicMetadata.roles. Set on PRODUCTION so every preview inherits it. Load-bearing twice over:
# GET /testing/session mints a sign-in ticket for THIS id and nothing else, and the auth layer REFUSES
# this id on production - the deny that makes the preview sign-in link safe to sit in a PR comment,
# since every environment shares the one production Clerk instance. Blank disables both.
E2E_CLERK_USER_ID=

# SHA-256 hex of a preview environment's per-env session key K. The preview-env workflow generates K,
# sets this on that environment's backend service, and puts K itself only in the PR comment. GET
# /testing/session compares sha256(?key=) against it in constant time. PER-ENVIRONMENT, set by CI -
# never on production. Blank closes the route's key path. A hash is a verifier, not a credential.
TESTING_SESSION_KEY_HASH=

# Password of the read-only Postgres login a preview environment clones production through. Set on
# PRODUCTION ONLY. Production is what CREATES the role from it at startup (preview_clone, LOGIN,
# pg_read_all_data and nothing else), and a Railway fork inherits every production variable at
# creation - so a fresh PR environment already holds the credential it needs to pg_dump the database
# it was forked from into its own empty Postgres. Cloning also needs the PG_DIRECT_* proxy
# coordinates, which production already carries for the Database Access page.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Blank turns cloning off on both sides: production mints no role, and a preview boots empty.
PREVIEW_CLONE_PASSWORD=

# Shared secret for POST/DELETE /preview-channels, which is how production learns a preview exists.
# Set on PRODUCTION: production verifies it, and a new preview inherits its copy from there at
# environment creation. This is the secret itself, not a digest - a preview has to present it, so
# both sides need the value. Blank on either side closes the route (401).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PREVIEW_REGISTRY_SECRET=

# Where a preview announces itself. Constant in practice; a variable only so a fork or a renamed
# service is a variable edit rather than a code change.
PRODUCTION_BACKEND_ORIGIN=https://backend-production-7866.up.railway.app

# Railway S3-compatible bucket (optional locally). Leave blank to skip; document-upload
# flows won't work without it.
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_NAME=

# Root log level for the backend's own loggers (app.*, main). main.py calls logging.basicConfig at
# import, so without this every logger.info() falls to Python's last-resort handler and is dropped
# below WARNING. Standard names only (DEBUG / INFO / WARNING / ERROR); anything else reads as INFO.
LOG_LEVEL=INFO

# Kill switch for the GP purchase-order mirror (the loop that walks GP's PO history and keeps the
# register a mirror of it). Default on. Set to false to stop the mirror without a code deploy.
GP_PO_SYNC_ENABLED=true

# THE READ BUDGET for every timer-driven GP read. One bucket shared by the PO mirror and the job
# sync, because one SQL server is what is being protected. A token is one purchase order (or job) a
# request will ask GP for, spent BEFORE the request goes out and refilling continuously.
#
# This replaced time gaps between requests, which were the wrong instrument: a gap between two
# requests that each re-read every open PO in a company is still an unbounded read. On 2026-09-03 one
# such read - UBC's 2,344 open POs in a single statement - pinned the server twice, and the second
# timed out on our side at 30s while GP carried on executing it. So: bounded work per request, and a
# fixed number of reads per minute.
#
# At 100 a minute and 25 keys a request that is one small statement every 15 seconds. UBC's 2,344 open
# POs are refreshed in about 24 minutes; a 25,000-PO history backfills in roughly 4 hours. Raising
# READS_PER_MINUTE shortens both proportionally and is the one knob to turn when the mirror is too far
# behind. READ_BATCH is capped at 100, which is the relay's own per-request key cap.
GP_SYNC_READS_PER_MINUTE=100
GP_SYNC_READ_BATCH=25

# How often the job sync adopts new GP jobs, in seconds. Also its SHARE of the read budget above:
# one company's pass costs JOBS_PER_READ for the unpageable list_jobs plus one read per job for the
# batched setup-health check - roughly 200 for a hundred-job company, so three companies is ~600
# reads. At 900 seconds that is ~40 a minute and leaves the PO mirror the rest; at the 300 it used to
# be hardcoded to it was 120 a minute, more than the entire budget, and the mirror was crowded out of
# a queue it is supposed to share. Jobs are created by hand a few times a week, so this is a backstop
# anyway - a relay reconnect and the admin Sync from GP button both cover "I just made one".
# Minimum 60.
GP_JOB_SYNC_POLL_SECONDS=900

# What one list_jobs costs the budget. The op cannot be paged and its size is unknown until the reply
# lands, so it is charged this flat estimate before the read - a company has roughly a hundred jobs,
# and charging 1 for a hundred-row read is how a budget stops meaning anything.
GP_SYNC_JOBS_PER_READ=100

# Backfill pages one pass drains for one company before the loop moves on, so a long backfill cannot
# hold every other company's open book hostage. It bounds a pass's LENGTH, not its rate - the budget
# above is the rate.
GP_PO_SYNC_BACKFILL_MAX_PAGES_PER_PASS=12

# WHEN the history drain may run. Massive sync jobs may not run during the working day, so the PO
# backfill - and only the backfill - is confined to a nightly window. Everything else (the paginated
# open-book refresh, the by-number closure fetch, the job sync) is bounded and budgeted and keeps
# running all day.
#
# Wall clock in the named zone, DST-aware: "20:00" is 8pm in Toronto whether that is 00:00 or 01:00
# UTC. The window may wrap midnight (20:00-05:00) or not (02:00-05:00); the end is exclusive, so
# 05:00 sharp is shut. A page already in flight when the window closes finishes and stores its cursor;
# the drain resumes from there the next night.
#
# EMPTY means no window at all - backfill allowed at any hour. That is the switch a preview
# environment flips to exercise the drain during the afternoon. An unparseable value logs an ERROR and
# falls back to the DEFAULT window, never to "any hour": the safe failure for a typo is less load on
# GP, not more. /health reports backfill_window and backfill_window_open.
GP_PO_SYNC_BACKFILL_WINDOW=20:00-05:00
GP_PO_SYNC_BACKFILL_WINDOW_TZ=America/Toronto

# Minimum gap between consecutive open-book refreshes of the SAME company, in seconds. Not a wait
# between requests: a refresh walks that company's open POs page by page as fast as the budget allows,
# and this only stops a company with a small open book from being re-read continuously. There is no
# all-companies sweep on reconnect any more - a wake resumes the rotation where it was.
GP_PO_SYNC_POLL_SECONDS=900

# Pause band, read from the relay's live sample of the server. At or above the PAUSE percentage (or
# with RUNNABLE_PAUSE tasks queued for a scheduler, which is CPU pressure an averaged percentage can
# miss) all background reads STOP. They resume only once CPU is back below the RESUME percentage AND
# the runnable queue is clear - the gap between 70 and 50 is what stops a server sitting at the line
# from flapping in and out of paused once per probe. A relay whose SQL login lacks VIEW SERVER STATE
# reports no sample; the budget alone then paces the reads, and one warning says so. An op that takes
# more than 3x its own median is the pressure signal that needs no permissions, and it charges the
# budget an extra batch rather than adding a delay.
GP_SYNC_SERVER_CPU_PAUSE_PCT=70
GP_SYNC_SERVER_CPU_RESUME_PCT=50
GP_SYNC_SERVER_RUNNABLE_PAUSE=8

# How often a paused sync asks the server how it is doing, via the cheap server_load op. That op is
# exempt from the relay's channel pin and is never refused, so the probe needs no GP company and works
# even before a hello has landed. A relay that refuses an op with server_busy supplies its own
# retry_after, which wins for the first probe. While paused NOTHING is drawn from the read budget at
# all - the brake sits on top of it.
GP_SYNC_SERVER_PROBE_SECONDS=60

# Only TIMER-DRIVEN reads are refusable: the backend marks them with a top-level "background" flag on
# the job frame, and the relay's busy gate keys on that rather than on the op name. Resolvers, the
# outbox worker and the admin Sync from GP button send no flag and are served whatever the server is
# doing - a person waiting on a button should get a slow answer, not a refusal. Samples that ride a
# user-facing reply may be old, so anything older than 120 seconds is ignored for pause decisions.

# How long a sync loop waits when the relay socket is up but its hello frame - which carries the GP
# company list - has not been read yet. Every connection passes through that state, because the loops
# are woken at try_register, one frame before the list exists. The read loop wakes them again when the
# hello lands, so this is the backstop for a relay that never sends one.
GP_SYNC_HELLO_GRACE_SECONDS=15
