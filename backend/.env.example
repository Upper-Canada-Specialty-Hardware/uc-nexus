# Manual reference for backend env vars. Copy to backend/.env and fill in real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uc_nexus

# Enables the GET /testing/clerk-sign-in token endpoint used by simulated user testing.
TESTING_ENABLED=true

# SHA-256 hex of the shared testing sign-in secret (#422). /testing/clerk-sign-in additionally
# requires an Admin/Manager session OR this digest's preimage in an X-Testing-Secret header -
# the secret is how a fresh PR environment mints its first session. Generate a pair with:
#   python -c "import secrets,hashlib; s=secrets.token_urlsafe(32); print(s, hashlib.sha256(s.encode()).hexdigest())"
# Blank disables the secret path (admin session only). Set per-environment; it always wins over the
# inherited digest below.
TESTING_SIGN_IN_SECRET_HASH=

# The same digest, under the name a PREVIEW environment inherits. PRODUCTION ONLY, and inert there:
# the resolver refuses to read it in production, which is what makes it safe to store where every new
# preview is cloned from. Without this, each PR environment needed the variable above set by hand
# before anything could be tested on it.
# Same generator one-liner as above. Blank keeps the manual per-environment path.
PREVIEW_TESTING_SIGN_IN_SECRET_HASH=

# Clerk DEV-instance secret key (sk_test_...). Needed for sign-in tokens and admin-gated
# resolvers. Get it from the shared dev Clerk instance. Never commit your real .env.
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk user id of the dedicated e2e testing account (preview-env autonomy plan). Not a real person -
# a user created once in the Clerk dashboard (e.g. e2e-tester@ucsh.com) and granted Admin/Manager via
# its publicMetadata.roles. Set on PRODUCTION so every preview inherits it. Load-bearing twice over:
# GET /testing/session mints a sign-in ticket for THIS id and nothing else, and the auth layer REFUSES
# this id on production - the deny that makes the preview sign-in link safe to sit in a PR comment,
# since every environment shares the one production Clerk instance. Blank disables both.
E2E_CLERK_USER_ID=

# SHA-256 hex of a preview environment's per-env session key K. The preview-env workflow generates K,
# sets this on that environment's backend service, and puts K itself only in the PR comment. GET
# /testing/session compares sha256(?key=) against it in constant time. PER-ENVIRONMENT, set by CI -
# never on production. Blank closes the route's key path. A hash is a verifier, not a credential.
TESTING_SESSION_KEY_HASH=

# SHA-256 hex of the workstation relay's Bearer secret, copied from Admin -> Relay Installs
# ("Seed hash" on the enrolled row). Lets a non-production backend accept that relay without a
# provision + enroll cycle (#414). Only used when PREVIEW_REAL_RELAY is on - the default preview seeds
# the stub hash below instead. On Railway it belongs on PRODUCTION, sitting there inert: a PR
# environment is cloned from production and inherits it, and the backend refuses to seed in production
# (#431). That inheritance is taken at environment creation, so a PR environment that already existed
# needs the variable set on its own backend service as well. Blank disables seeding.
RELAY_SEED_SECRET_HASH=

# SHA-256 hex of the STUB relay's Bearer secret - the DEFAULT preview relay credential. A preview
# normally runs a fixture-backed stub relay inside the environment, so nothing depends on an office
# workstation being switched on for a PR to be testable. Unlike the hash above this is minted PER
# PREVIEW by the preview-env workflow, which sets it here and the matching secret on the stub service.
# Never set on production.
RELAY_STUB_SECRET_HASH=

# Whether THIS preview wants the real workstation relay instead of the stub. Off by default. Turning
# it on switches the seeded credential to RELAY_SEED_SECRET_HASH and makes this backend announce
# itself to production so the workstation relay is told to dial it. Set per environment, never on
# production.
PREVIEW_REAL_RELAY=false

# Shared secret for POST/DELETE /preview-channels, which is how production learns a preview exists.
# Set on PRODUCTION: production verifies it, and a new preview inherits its copy from there at
# environment creation. Unlike the seed hashes this is the value itself, not a digest - a preview has
# to present it. Blank on either side closes the route (401).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PREVIEW_REGISTRY_SECRET=

# Where a preview announces itself. Constant in practice; a variable only so a fork or a renamed
# service is a variable edit rather than a code change.
PRODUCTION_BACKEND_ORIGIN=https://backend-production-7866.up.railway.app

# Railway S3-compatible bucket (optional locally). Leave blank to skip; document-upload
# flows won't work without it.
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_NAME=
